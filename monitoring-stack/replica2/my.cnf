# [레플리카] 안전한 적용/관리 중심 설정
[mysqld]
server-id=102                          # ★ 각 레플리카마다 고유값 (replica2는 102 등)
relay_log=/var/lib/mysql/relay-bin     # 레플리카 중간 저장 로그
relay_log_recovery=ON                  # ★ 비정상 종료 후 relay-log 재검증/복구
relay_log_purge=ON                     # 적용 완료된 relay log 자동 정리

# 읽기 전용(운영 안전)
read_only=ON                           # 애플리케이션이 레플리카에 잘못 쓰는 것 방지
super_read_only=ON                     # SUPER 권한 사용자까지 쓰기 차단(운영 안정)

# 메타데이터 TABLE 저장(내구성 ↑)
master_info_repository=TABLE
relay_log_info_repository=TABLE

# 내구성/일관성 (레플리카도 적용 권장)
innodb_flush_log_at_trx_commit=1
sync_binlog=1
skip_networking=0

# 복제 병렬 적용 튜닝(필요 시)
# replica_parallel_workers=4           # MySQL 8: 코디네이터/워커 병렬 적용
# binlog_transaction_dependency_tracking=WRITESET # 의존성 기반 병렬성 향상(소스에 설정)